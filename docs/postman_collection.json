{
  "info": {
    "name": "AI WarRoom API",
    "description": "Session login, then the whole flow: model a business, simulate, ask the AI, scan a site, decide. Set `email` and `password`, then run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Django checks a CSRF token on every unsafe request made with a session cookie.",
          "// Copy it from the cookie jar into the X-CSRFToken header automatically.",
          "const token = pm.cookies.get('csrftoken');",
          "if (token) pm.request.headers.upsert({ key: 'X-CSRFToken', value: token });",
          "pm.request.headers.upsert({ key: 'Referer', value: pm.collectionVariables.get('baseUrl') + '/' });",
          "pm.collectionVariables.set('csrftoken_cookie', token || '');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email",
      "value": "demo@example.test"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "csrftoken_cookie",
      "value": ""
    },
    {
      "key": "businessId",
      "value": ""
    },
    {
      "key": "scenarioId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "decisionId",
      "value": ""
    },
    {
      "key": "eventsUrl",
      "value": ""
    },
    {
      "key": "alertId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Log in (run these first)",
      "item": [
        {
          "name": "Get CSRF cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "login"
              ]
            },
            "description": "Loads the login page so Django sets the csrftoken cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('got csrftoken cookie', () => pm.expect(pm.cookies.get('csrftoken')).to.be.ok);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in (session)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "login"
              ]
            },
            "description": "Form login, same as the browser. Create the account first with `python manage.py seed_kirana --email ...` or the sign-up page.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                },
                {
                  "key": "csrfmiddlewaretoken",
                  "value": "{{csrftoken_cookie}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.expect(pm.response.code).to.be.oneOf([200, 302]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
